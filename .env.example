# Server wallet holding USDC on Base mainnet. Use a burner, fund it with ~$20.
AGENT_PRIVATE_KEY=0x
# Optional: override Base RPC (defaults to public endpoint)
BASE_RPC_URL=
# Claude API key for the agent
# Optional: per-session spend budget in USD (default 15; each purchase also capped at $10)
SESSION_BUDGET_USD=
# Optional: 1 = purchases run every check but stop before paying for the card (fees only)
DRY_RUN=
# ElevenLabs key: needs Speech to Text and Text to Speech permissions
ELEVENLABS_API_KEY=
# Optional: ElevenLabs voice for replies (default: premade "George")
ELEVENLABS_VOICE_ID=
